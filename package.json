{
  "name": "papero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node --env-file-if-exists=.env scripts/prepare-data.mjs",
    "build:local": "PAPERO_INCLUDE_LOCAL_DATA=1 npm run build",
    "build:library": "node scripts/verify-release-data.mjs --data-dir paper-data && DATA_DIR=paper-data PAPERO_INCLUDE_LOCAL_DATA=1 npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b && vitest run && node --test scripts/*.test.mjs",
    "test": "vitest run",
    "paper:import": "node --env-file-if-exists=.env scripts/import-paper.mjs",
    "paper:import-pdf": "node --env-file-if-exists=.env scripts/import-pdf.mjs",
    "article:import": "node --env-file-if-exists=.env scripts/import-qwen-blog.mjs",
    "paper:translate": "node --env-file-if-exists=.env scripts/translate-paper.mjs",
    "paper:benchmark": "node --env-file-if-exists=.env scripts/benchmark-lm-studio.mjs",
    "library:translate": "node --env-file-if-exists=.env scripts/translate-library.mjs",
    "paper:verify": "node --env-file-if-exists=.env scripts/verify-data.mjs",
    "data:export": "node --env-file-if-exists=.env scripts/prepare-data.mjs --include --out-dir .cache/export"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.16",
    "katex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
